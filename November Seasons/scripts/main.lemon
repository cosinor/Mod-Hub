global bool nvs.lbz
global bool nvs.mhz
global bool nvs.lrz_hpz
global bool nvs.bpz

global bool nvs.bsk
global bool nvs.lbz1_egg
global bool nvs.lbz2_fgc
global bool nvs.mhz1_grnd
global bool nvs.mhz2_ssn
global bool nvs.lrz_bnk

global u16 fade_state = 0
global u16 fade_time = 0
global bool mhz.after_fade = false

global bool nvs.dsp
global u16 nvs.em_line

global u8 nvs.ds_zone

// TCA Compatibility Function
function bool isKnucklesRoute()
{
	return base.isKnucklesRoute()
}

//# post-update-hook
function void PostFrameUpdate() // zone palettes
{	
	if (nvs.bsk && global.zone == 1)
	{
		System.loadExternalRawData("1103_big_shaker_palette", 0x6ae56)
		System.loadExternalRawData("1103_big_shaker_damage_palette", 0x6acd8)
	}

	if (nvs.lbz && global.zone == 6)
	{
		System.loadExternalRawData("1103_lbz1_palette", 0xa929c)
		System.loadExternalRawData("1103_lbz2_palette", 0xa92fc)
		System.loadExternalRawData("1103_lbz2_water_palette", 0xa935c)

		if (!nvs.lbz2_fgc)
		{	
			if (global.act == 0x01 || level.restart)
				fade_state = 0
				
			if (level.wait_for_results != 0 && fade_state == 0)
			{
				fade_state = 1
				fade_time = 0
			}
			
			if (fade_state == 1 && fade_time <= 0x78 && !global.game.paused)
			{			
				fade_time += 3
				if (fade_time % 24 == 0)
				{
					for (u8 i = 0; i < 32; i++)
						u16[0xfffffc00 + (0x21 + i)*2] = blendColorsPacked(u16[0xa929c + (0x11 + i)*2], u16[0xa92fc + (0x11 + i)*2], min(256, fade_time * 2 + fade_time / 8 + 1))
				}
			}
		}

		if (nvs.lbz1_egg)
			System.loadExternalRawData("1103_lbz1_rusty_palette", 0xa929c)

		if (nvs.lbz2_fgc)
			System.loadExternalRawData("1103_lbz2_gold_palette", 0xa92fc)
	}

	if (global.zone == 7 && nvs.mhz)
	{
		System.loadExternalRawData(nvs.mhz1_grnd ? "1103_mhz1_complete_palette" : "1103_mhz1_palette", 0xa943c)
		
		if (nvs.mhz2_ssn)
		{
			System.loadExternalRawData(nvs.mhz1_grnd ? "1103_mhz2_autumn_complete_palette" : "1103_mhz2_autumn_palette", 0xa949c)
			System.loadExternalRawData(nvs.mhz1_grnd ? "1103_mhz2_winter_complete_palette" : "1103_mhz2_winter_palette", 0x550fe)
		}

		if (Mods.isModActive("Time Consistent Adventure") || Mods.isModActive("Useott's Original Zone Order") || Mods.isModActive("UOZO Palettes"))
		{
			if (!isKnucklesRoute() && System.getGlobalVariableValueByName("tca.mvz") && System.getGlobalVariableValueByName("tca.intended") && global.act == 0x01 && camera.position.x.u16 > 0x3ae5 - getScreenExtend())
				System.loadExternalRawData(nvs.mhz1_grnd ? "1103_mhz2_sunset_boss_complete_palette_tca/uozo": "1103_mhz2_sunset_boss_palette_tca/uozo", 0xa943c)
				
			if (System.getGlobalVariableValueByName("useottsOriginalZoneOrder.mhzSunsetPalette") == 1 && global.act == 0x01 && camera.position.x.u16 > 0x3abd)
				System.loadExternalRawData(nvs.mhz1_grnd ? "1103_mhz2_sunset_boss_complete_palette_tca/uozo" : "1103_mhz2_sunset_boss_palette_tca/uozo", 0xa943c)
		}
	}

	if (nvs.lrz_hpz)
	{
		if (global.zone == 9) // 1103 LRZ1
		{
			System.loadExternalRawData("1103_lrz1_palette_cycle", 0x3322)
			System.loadExternalRawData("1103_lrz1_palette", 0xa967c)
			System.loadExternalRawData("1103_lrz1_miniboss_palette", 0x78e2a)
			
			if (nvs.lrz_bnk)
				System.loadExternalRawData("1103_lrz1_badnik_palette", 0xa967c)
			
			System.loadExternalRawData("1103_lrz2_intro_palette", 0x78e6a) //1103 LRZ2
			System.loadExternalRawData("1103_lrz2_palette", 0xa96dc)
		}
		
		if (global.zone_act == 0x1600)	
			System.loadExternalRawData("1103_lrz2_cooledboss_palette", 0xa9cdc)
				
		if (global.zone_act == 0x1601) || (global.zone_act == 0x1701) // 1103 Styled HPZ
		{
			System.loadExternalRawData("1103_hpz_intro_palette", 0xa9d5c)
			System.loadExternalRawData("1103_hpz_maingame_palette", 0x669fe)
		}
	}

	if (nvs.bpz) // pre 1103 BPZ
		System.loadExternalRawData("1103_leftover_bpz", 0xa9a3c)
		
	else if (!nvs.bpz)
		System.loadExternalRawData("final_bpz_portrait", 0x20a5de)

	base.PostFrameUpdate()
}

function bool Standalone.onDrawVdpSpriteCompound(s16 px, s16 py, u8 size, u16 index, u16 renderQueue, u8 spriteCounter) // Re-render save slot arrows
{
	if (objA0.update_address == 0x00d42c)
	{
		if (objA0.compound.count >= 1 && (index == 0x83bd || index == 0x93bd))
		{
			Renderer.drawVdpSprite(px, py, size, index, 0x9ffa)
			return true
		}
	
		else if (objA0.compound.count >= 2 && objA0.compound.sprite2.animation.sprite == 0x17)
		{
		#if !COSINOR_PORT_CUSTOMIZER_ACTIVE
			if (nvs.ds_zone == 0x05 && (nvs.lbz && nvs.lbz1_egg) || nvs.ds_zone == 0x09 && (nvs.lrz_hpz || nvs.dsp) || nvs.ds_zone == 0x0c && nvs.dsp)
				return true
		#endif
		}
	}
	
	return base.Standalone.onDrawVdpSpriteCompound(px, py, size, index, renderQueue, spriteCounter)
}

//# address-hook(0x0d96a) end(0x0d9f2) 
function void fn00d96a() // Additional data select zone portraits
{
	u16 posX = (u16[A0 + 0x12] - camera.foreground.x.u16) - 168
	u16 posY = 0x10 + (getScreenHeight() - 224) / 2
	
	string icon
	u16 atex = 0x30
	
	nvs.ds_zone = D1.u8
	
	if !(nvs.ds_zone == objA0.value3a && objA0.value3b != 0) && u16[0xffffb04a + 0x2e] == 0
	{
		if (nvs.ds_zone == 0x05)
		{
			if (nvs.lbz && nvs.lbz1_egg)
			{
				icon = "lbz_rusty"
				#if COSINOR_PORT_CUSTOMIZER_ACTIVE
				{
					cosinor.CustomPortraitPalette("lbz_rusty", 0)
					atex = 0xa0 + (spc.pal_line - 1) * 0x10
				}
				#else
				{
					SpriteHandle dataselpreview = Renderer.addSpriteHandle("lbz_rusty", posX, posY, 0x9ff9)
					dataselpreview.setFlags(SPRITE_FLAG_PRIO)
					dataselpreview.setPalette("lbz_rusty", 0)
				}
				#endif
			}
		}

		if (nvs.mhz)
			System.loadExternalRawData("1103_mhz_zone_card", 0x0cbd8)

		if (nvs.ds_zone == 0x09)
		{
			if (nvs.dsp && !(nvs.lrz_hpz))
				icon = "old_lrz"

			else if (nvs.lrz_hpz)
			{	
				System.loadExternalRawData("1103_lrz_zone_card", 0xcc38)

				if (nvs.dsp)
					icon = "old_lrz_1103"
				else
					icon = "lrz_1103"
			}
		}

		if (nvs.lrz_hpz)
			System.loadExternalRawData("1103_hpz_zone_card", 0xcc58)

		if (nvs.dsp && nvs.ds_zone == 0x0c)
			icon = "old_dez"

		u16 portraitQueue = cosinor.MJCheck() ? 0x9fe2 : 0x9ff9

		if Renderer.hasCustomSprite(icon)
		{
			if icon != "lbz_rusty"
				Renderer.drawSprite(icon, posX, posY, atex, SPRITE_FLAG_PRIO, portraitQueue)
			else if Mods.isModActive("Customizable Save Portraits")
				Renderer.drawSprite("lbz_rusty", posX, posY, atex, SPRITE_FLAG_PRIO, portraitQueue)
		}
	}
	
	base.fn00d96a()
}

function bool cosinor.MJCheck() // allows MJ's custom portraits to display over mine when enabled
{
	return base.cosinor.MJCheck()
}

function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue) // Extra Sprites
{
	u16 ext_atex = 0xa0 + (nvs.em_line - 1) * 0x10
	s16 flag = (objA0.sprite_attributes & sprite_attribute.PRIORITY) ? SPRITE_FLAG_PRIO : 0
	
	if (nvs.lrz_hpz)
	{
		if (objA0.update_address == 0x09089e || objA0.update_address == 0x090880) && objA0.animation.sprite == 6
		{	
			string key = "blurple_emerald_super"
		
			if (Game.getSetting(SETTING_GFX_ANTIFLICKER) && !(Mods.isModActive("Emeralds Don't Flash")))
			{
				bool isFadingBackToMainGame = (global.game_mode == 0x0c && global.stage_type == 1)
				if ((global.framecounter.low & 0x01) || isFadingBackToMainGame)
					Renderer.drawSprite(key, px - 0x18, py - 0x10, ext_atex, flag, renderQueue)
				else
				{	
					u32 glow = abs((global.framecounter.low & 0x7f) - 0x40)
					
					SpriteHandle blurple_emerald = Renderer.addSpriteHandle(key, px - 0x18, py - 0x10, renderQueue)
					blurple_emerald.setFlags(flag | SPRITE_FLAG_NO_GLOBAL_TINT)
					blurple_emerald.setPaletteOffset(ext_atex)
					
					blurple_emerald.setTintColorRGBA(convertColors32(0xffc0c0c0 - 0x10101 * glow))
					blurple_emerald.setAddedColorRGB(0x10101 * glow)
				}
			}
			
			else
				Renderer.drawSprite(key, px - 0x18, py - 0x10, ext_atex, flag, renderQueue)
			
			return true
		}
		
		if (objA0.update_address == 0x090e1c || objA0.update_address == 0x090e4e || objA0.update_address == 0x090e72 || objA0.update_address == 0x090e86) && objA0.animation.sprite == 6
		{
			Renderer.drawSprite("blurple_emerald_chaos", px - 0x04, py - 0x05, ext_atex, flag, renderQueue)
			return true
		}
	}
	
	if !(nvs.bpz) && (objA0.update_address == 0x00af58 && competition_mode.menu.stage == 1)
	{
		Renderer.drawSprite("final_bpz", px - 0x20, py - 0x18, 0x20, flag, renderQueue)
		return true
	}

	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

function void NVS.EmeraldPalette() // Extended palette for last super emerald
{
	u32 dest = (global.zone_act == 0x1601 ? 0x802002 : 0x802182) + (3 * 0x40 + (nvs.em_line - 1) * 0x20)
	constant array<u16> EMERALD_HPZ = {0xeee, 0xeea, 0xec6, 0xca2, 0x860, 0x440}
				
	for (u16 i = 0; i < EMERALD_HPZ.length(); i++)
		u16[dest + 2*i] = EMERALD_HPZ[i]
}

//# address-hook(0x002ac0) end(0x002af4)
function void LevelPaletteUpdate.HPZ() // Adding the extended palette
{
	base.LevelPaletteUpdate.HPZ()
	
	if (nvs.lrz_hpz) && (camera.foreground.x.u16 >= 0x1402)
		NVS.EmeraldPalette()
}

//# address-hook(0x05aa02) end(0x05aa2e)
function void InitLevelTiles.EC()
{
	base.InitLevelTiles.EC()
	
	if (nvs.lrz_hpz)
		NVS.EmeraldPalette()
}

function string ActSelect.GetZonePreviewKey(u8 zone, u8 act, u8 image) // Act Select previews
{
	if (Mods.isModActive("OZO Act Select") && (Mods.isModActive("Original zone order") || Mods.isModActive("Useott's Original Zone Order") || Mods.isModActive("Time Consistent Adventure") && System.getGlobalVariableValueByName("tca.intended")))
	{
		if Mods.isModActive("jam-difficulty-pale") && (System.getGlobalVariableValueByName("jd.mode") == 0x01)
		{
			if (nvs.lbz)
			{
				if zone == 6
					return stringformat((!nvs.lbz2_fgc ? "nvs_zone06_act2%s" : "nvs_zone06_act2%s_d"), (image % 2 == 0) ? "a" : "b")
			}
	
			if (nvs.mhz)
			{
				if zone == 7
					return stringformat("nvs_zone07_act1%s", (image % 2 == 0) ? "a" : "b")
			}

		}

		if (nvs.lbz)
		{
			if zone == 6 && act == 0
			{
				if (!nvs.lbz1_egg)
				{
					if (image != 1) && (levelselect.characters == 3 || levelselect.characters == 4)
						return "nvs_zone06_act1a_knux_g"

					return stringformat("nvs_zone06_act1%s_g", (image % 2 == 0) ? "a" : "b")
				}

				else
				{
					if (image != 1) && (levelselect.characters == 3 || levelselect.characters == 4)
						return "nvs_zone06_act1a_knux_r"

					return stringformat("nvs_zone06_act1%s_r", (image % 2 == 0) ? "a" : "b")
				}
			}

			if zone == 6 && act == 1
				return stringformat((!nvs.lbz2_fgc ? "nvs_zone06_act2%s" : "nvs_zone06_act2%s_d"), (image % 2 == 0) ? "a" : "b")
		}
	
		if (nvs.mhz)
		{
			if zone == 7 && act == 0
				return stringformat("nvs_zone07_act1%s", (image % 2 == 0) ? "a" : "b")

			if zone == 7 && act == 1
			{
				if (nvs.mhz2_ssn)
					return stringformat("nvs_zone07_act2%s_ssn", (image % 2 == 0) ? "a" : "b")
			}
		}
	}

	else
	{
		if Mods.isModActive("jam-difficulty-pale") && (System.getGlobalVariableValueByName("jd.mode") == 0x01)
		{
			if (nvs.lbz)
			{
				if zone == 5
					return stringformat((!nvs.lbz2_fgc ? "nvs_zone06_act2%s" : "nvs_zone06_act2%s_d"), (image % 2 == 0) ? "a" : "b")
			}
	
			if (nvs.mhz)
			{
				if zone == 6
					return stringformat("nvs_zone07_act1%s", (image % 2 == 0) ? "a" : "b")
			}

		}

		if (nvs.lbz)
		{
			if zone == 5 && act == 0
			{
				if(!nvs.lbz1_egg)
				{
					if (image != 1)
					{
						if (levelselect.characters == 3 || levelselect.characters == 4)
							return "nvs_zone06_act1a_knux_g"
					}

					return stringformat("nvs_zone06_act1%s_g", (image % 2 == 0) ? "a" : "b")
				}

				else
				{
					if (image != 1)
					{
						if (levelselect.characters == 3 || levelselect.characters == 4)
							return "nvs_zone06_act1a_knux_r"
					}

					return stringformat("nvs_zone06_act1%s_r", (image % 2 == 0) ? "a" : "b")
				}
			}

			if zone == 5 && act == 1
				return stringformat((!nvs.lbz2_fgc ? "nvs_zone06_act2%s" : "nvs_zone06_act2%s_d"), (image % 2 == 0) ? "a" : "b")
		}
	
		if (nvs.mhz)
		{
			if zone == 6 && act == 0
				return stringformat("nvs_zone07_act1%s", (image % 2 == 0) ? "a" : "b")

			if zone == 6 && act == 1
			{
				if (nvs.mhz2_ssn)
					return stringformat("nvs_zone07_act2%s_ssn", (image % 2 == 0) ? "a" : "b")
			}
		}
	}

	if (nvs.lrz_hpz)
	{
		if zone == 9 && act == 0
		{
			if image == 1
				return (nvs.lrz_bnk ? "nvs_zone10_act1b_bnk" : "nvs_zone10_act1b")
	
			return stringformat("nvs_zone10_act1%s", (image % 2 == 0) ? "a" : "b")
		}

		if zone == 9 && act == 1
			return stringformat("nvs_zone10_act2%s", (image % 2 == 0) ? "a" : "b")
		
		if zone == 10 && act == 0
			return stringformat("nvs_zone11_act1%s", (image % 2 == 0) ? "a" : "b")
	}

	return base.ActSelect.GetZonePreviewKey(zone, act, image)
}

function void Renderer.drawSprite(u64 key, s16 px, s16 py, u16 atex, u8 flag, u16 renderQueue) // S3C Level Select+ icons
{	
	if (nvs.lbz) && (key == "S3CompleteSelect_Zone6")
	{
		if (nvs.lbz1_egg)
			key = "S3CompleteSelect_Zone6_Rusty"
	}

	else if (nvs.mhz) && (key == "S3CompleteSelect_Zone7")
		key = "1103_S3CompleteSelect_Zone7"
	
	else if (key == "S3CompleteSelect_Zone10")
	{
		if (nvs.dsp)
			key = (!nvs.lrz_hpz ? "S3CompleteSelect_Zone10_Old" : "1103_S3CompleteSelect_Zone10_Old")
		
		else if (nvs.lrz_hpz)
			key = "1103_S3CompleteSelect_Zone10"
	}

	else if (nvs.lrz_hpz) && (key == "S3CompleteSelect_Zone11")
		key = "1103_S3CompleteSelect_Zone11"

	else if (nvs.dsp) && (key == "S3CompleteSelect_Zone13")
		key = "S3CompleteSelect_Zone13_Old"

	base.Renderer.drawSprite(key, px, py, atex, flag, renderQueue)
}