global bool spc.new_hcz
global bool spc.old_fbz
global bool spc.old_lrz
global bool spc.old_dez
global bool spc.silly

global u16 spc.pal_line

#define COSINOR_PORT_CUSTOMIZER_ACTIVE = true

//# address-hook(0x00d96a) end(0x00d9f2)
function void fn00d96a() // Where new portraits are drawn
{
	u16 slotIsActive = (u16[0xffffb04a + 0x2e] == 0)
	
	string card
	u16 posX = (u16[A0 + 0x12] - camera.foreground.x.u16) - 168
	u16 posY = 0x10 + (getScreenHeight() - 224) / 2
	u16 atex = 0x30
	
	u8 shownImage = u16[A0 + 0x36]
	u8 defaultImage = objA0.value3a
	u8 playthroughStatus = objA0.value3b
	u8 slotnum = max(s16(u16[A0 + 0x34] - 1), 0) // Character selection AFTER kte & Tails	
	u16 chars = u16[A0 + 0x34]

	bool ecf_slot = false
#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
	if ECF_dataselect_getStr()
		ecf_slot = true
#endif

	if (slotIsActive)
	{
		if !(shownImage == defaultImage && playthroughStatus != 0) // Base Zone Portraits
		{	
			card = stringformat("zoneCard_%d", shownImage)
			
			if (spc.new_hcz && shownImage == 0x01)
			{
				card = "new_hcz"
				atex = 0xa0 + (spc.pal_line - 1) * 0x10
				cosinor.CustomPortraitPalette("custom_portraits", 1)
			}
			
			else if (spc.old_fbz && shownImage == 0x07)
			{
				card = "old_fbz"
				atex = 0xa0 + (spc.pal_line - 1) * 0x10
				cosinor.CustomPortraitPalette("custom_portraits", 2)
			}

			if !(Mods.isModActive("November Seasons") && System.getGlobalVariableValueByName("nvs.dsp"))
			{
				if (spc.old_lrz && shownImage == 0x09)
					card = "old_lrz"
					
				else if (spc.old_dez && shownImage == 0x0c)
					card = "old_dez"
			}
		}
		
		else if (slotnum < 4 && !ecf_slot) // Base Clear Portraits
		{
			if (chars <= CHARS_SONIC_ALONE)
				card = (objA0.animation.frame == 0x18 ? "clearCard_sonic" : objA0.animation.frame == 0x19 ? "clearCard_sonic_super" : 0)
												
			if (objA0.animation.frame == 0x23)
			{
				if (chars == CHARS_TAILS_ALONE)
				{
					card = (playthroughStatus == 1 ? (spc.silly ? "clearCard_tails_silly" : "clearCard_tails") : playthroughStatus == 2 ? "clearCard_tails_super" : 0)
					
					if (spc.silly == 2 && playthroughStatus == 1)
					{
						atex = 0xa0 + (spc.pal_line - 1) * 0x10
						cosinor.CustomPortraitPalette("custom_portraits", 0)
					}
				}
							
				else
					card = (playthroughStatus == 1 ? "clearCard_kte" : playthroughStatus == 2 ? "clearCard_kte_super" : 0)
			}
					
			if (objA0.animation.frame == 0x1b)
				card = "clearCard_best"
		}
	}
	
	u16 portraitQueue = cosinor.MJCheck() ? (ecf_slot && (card == "new_hcz" && !System.getGlobalVariableValueByName("MF.HCZPORTRAIT")) ? 0x9ff0 : 0x9fe2) : 0x9ff8
	
	if Renderer.hasCustomSprite(card)
		Renderer.drawSprite(card, posX, posY, atex, SPRITE_FLAG_PRIO, portraitQueue)
		
	base.fn00d96a()
}

function void cosinor.CustomPortraitPalette(u64 src, u8 line) // Extended palette line for portraits with custom palettes
{
	u32 DestAD = 0x802000 + (3 * 0x40 + (spc.pal_line - 1) * 0x20)
	u32 numColors = System.loadExternalPaletteData(src, line, 0x800000, 0x10)

	for (u32 i = 0; i < numColors; i ++)
	{
		u32 rgba = u32[0x800000 + i * 4]
		u16[DestAD + 2 * i] = (rgba & 0xff000000) ? packColorExt(rgba) : 0
		
		if (Mods.isModActive("nabbup-the-works"))
		{
			if !(System.getGlobalVariableValueByName("TW_FADEIN_STYLE"))
				u16[DestAD + 2 * i] = TW.fakeOriginalTint_DataSel(makeNormalPackedColor(u16[DestAD + 2 * i]))
			else
			{
				u16 color = u16[DestAD + 2 * i]
				u32 unpacked = applyGlobalComponentTint_BGR32(unpackColor(color))
				u16[DestAD + 2 * i] = makeNormalPackedColor(packColorExt(unpacked))
			}	
		}
	}
}

function bool cosinor.MJCheck() // allows MJ's custom portraits to display over mine when enabled
{
	return (u16[A0 + 0x36] == 0x01 && System.getGlobalVariableValueByName("MF.HCZPORTRAIT")) || (u16[A0 + 0x36] == 0x05 && System.getGlobalVariableValueByName("MF.LBZPORTRAIT")) || (u16[A0 + 0x36] == 0x0c && System.getGlobalVariableValueByName("MF.DEZPORTRAIT")) || System.getGlobalVariableValueByName("MF.CHARPORTRAITS") && objA0.animation.frame != 0x17 && ((u16[A0 + 0x34] <= CHARS_SONIC_ALONE && objA0.value3b < 3) || (u16[A0 + 0x34] == CHARS_TAILS_ALONE && objA0.value3b == 2))
}

function bool MF.useNewPortraits() // for the above function to work
{
	return base.MF.useNewPortraits()
}

function u16 TW.fakeOriginalTint_DataSel(u16 target)
{
	return TW.fakeOriginalTint_DataSel(target)
}

// Re-render save slot arrows to appear above custom portraits & remove the original portraits
function bool Standalone.onDrawVdpSpriteCompound(s16 px, s16 py, u8 size, u16 index, u16 renderQueue, u8 spriteCounter)
{
	if (objA0.update_address == 0x00d42c)
	{
		if objA0.compound.count >= 1 && (index == 0x83bd || index == 0x93bd)
		{
			Renderer.drawVdpSprite(px, py, size, index, 0x9ffa)
			return true
		}
		
		else if (objA0.compound.count >= 2)
			return true
	}
	
	return base.Standalone.onDrawVdpSpriteCompound(px, py, size, index, renderQueue, spriteCounter)
}

function void Renderer.drawSprite(u64 key, s16 px, s16 py, u16 atex, u8 flags, u16 renderQueue) // S3C LS+ Custom Portraits
{
	if (spc.new_hcz && key == "S3CompleteSelect_Zone2")
		key = "S3CIcon_Zone2_New"
	
	if !(Mods.isModActive("November Seasons") && System.getGlobalVariableValueByName("nvs.dsp"))
	{
		if (spc.old_lrz && key == "S3CompleteSelect_Zone10")
			key = "S3CIcon_Zone10_Old"

		else if (spc.old_dez && key == "S3CompleteSelect_Zone13")
			key = "S3CIcon_Zone13_Old"
	}
	
	base.Renderer.drawSprite(key, px, py, atex, flags, renderQueue)
}